                {
                  "key": "dateTo",
                  "value": "2024-12-31"
                },
                {
                  "key": "periodicidade",
                  "value": "mensal"
                }
              ]
            },
            "description": "Obtém relatório de fluxo de caixa"
          },
          "response": []
