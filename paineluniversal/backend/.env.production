# =========================
# PAINEL UNIVERSAL - CONFIGURAÇÃO COMPLETA
# =========================
# Para usar: renomeie este arquivo para .env

# === APLICAÇÃO PRINCIPAL ===
APP_NAME="Painel Universal"
APP_VERSION="7.0.0"
APP_ENV=production
SECRET_KEY=gere-uma-chave-segura-com-openssl-rand-base64-48
JWT_SECRET=outra-chave-segura-diferente-da-anterior
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# === DATABASE ===
# SQLite (desenvolvimento)
# DATABASE_URL=sqlite:///./eventos.db

# PostgreSQL (produção) - Configure com suas credenciais
DATABASE_URL=postgresql://usuario:senha@localhost:5432/painel_universal

# === ADMIN INICIAL ===
INITIAL_ADMIN_EMAIL=toretomal@icloud.com
INITIAL_ADMIN_PASSWORD=Sup3rSenha!123
INITIAL_ADMIN_CPF=00000000000
INITIAL_ADMIN_NAME="Admin Master"

# === CORS ===
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# === REDIS (Cache) ===
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# === EMAIL ===
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-app
EMAIL_FROM=noreply@paineluniversal.com
EMAIL_USE_TLS=true

# === WHATSAPP ===
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
N8N_WEBHOOK_URL=

# === INTEGRAÇÃO MEEP ===
MEEP_ENABLED=true
MEEP_BASE_URL=https://beta.portal.meep.com.br
MEEP_AUTH_MODE=bearer
MEEP_USER=seu-usuario@meep.com.br
MEEP_PASS=sua-senha-meep
MEEP_SYNC_INTERVAL=3600
MEEP_TIMEOUT=30

# === FEATURES ===
ENABLE_DOCS=true
ENABLE_HEALTHCHECK=true
ENABLE_ANALYTICS=true
ENABLE_WEBSOCKETS=true
ENABLE_AUTO_MIGRATION=true

# === LOGGING ===
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# === UPLOAD ===
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760

# === TIMEZONE ===
TIMEZONE=America/Sao_Paulo

# === RAILWAY (se usar Railway) ===
RAILWAY_ENVIRONMENT=production
RAILWAY_STATIC_URL=

# === DESENVOLVIMENTO ===
DEBUG=false
RELOAD=false
WORKERS=4