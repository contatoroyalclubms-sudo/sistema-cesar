# Configuração dos testes E2E

# URL da aplicação
BASE_URL=http://localhost:5173
API_URL=http://localhost:8000

# Credenciais de teste
TEST_ADMIN_CPF=123.456.789-09
TEST_ADMIN_PASSWORD=Admin@123

TEST_PROMOTER_CPF=987.654.321-00
TEST_PROMOTER_PASSWORD=Promoter@123

TEST_CLIENTE_CPF=111.222.333-44
TEST_CLIENTE_PASSWORD=Cliente@123

# Configurações de execução
HEADLESS=true
SLOW_MO=0
TIMEOUT=30000
RETRY_COUNT=2

# Configurações de CI/CD
CI=false
PARALLEL_WORKERS=4

# Screenshots e vídeos
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true

# Relatórios
REPORT_OUTPUT=html
JUNIT_OUTPUT=test-results/junit.xml