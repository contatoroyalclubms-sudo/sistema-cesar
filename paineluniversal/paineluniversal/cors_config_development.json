{
  "environment": "development",
  "cors": {
    "allow_credentials": true,
    "expose_headers": [
      "Content-Range",
      "X-Content-Range"
    ],
    "max_age": 86400,
    "allow_origins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "http://localhost:8080",
      "http://localhost:4200"
    ],
    "allow_methods": [
      "*"
    ],
    "allow_headers": [
      "*"
    ]
  },
  "security_notes": [
    "Configuração otimizada para development",
    "Origins restritas baseadas no ambiente",
    "Headers de segurança aplicados",
    "Credentials permitidas apenas para origins confiáveis"
  ]
}