          id: 2,
          nome: "Comidas",
          descricao: "Pratos principais e petiscos",
          cor: "#F59E0B",
          ativo: true,
          criado_em: (/* @__PURE__ */ new Date()).toISOString(),
          atualizado_em: (/* @__PURE__ */ new Date()).toISOString()
        }
      ];
    }
  },
  async criar(data) {
    try {
      const response = await api.post("/produtos/categorias/", data);
      return response.data;
    } catch (error) {
      console.error("Erro ao criar categoria:", error);
      const novaCategoria = {
        id: Date.now(),
        nome: data.nome,
        descricao: data.descricao,
        cor: data.cor || "#3b82f6",
        ativo: true,
        criado_em: (/* @__PURE__ */ new Date()).toISOString(),
        atualizado_em: (/* @__PURE__ */ new Date()).toISOString()
      };
      return novaCategoria;
    }
  },
  async obter(id) {
    try {
      const response = await api.get(`/produtos/categorias/${id}`);
      return response.data;
    } catch (error) {
      console.error("Erro ao obter categoria:", error);
      throw new Error("Categoria não encontrada");
    }
  },
  async atualizar(id, data) {
    try {
      const response = await api.put(`/produtos/categorias/${id}`, data);
      return response.data;
    } catch (error) {
      console.error("Erro ao atualizar categoria:", error);
      throw new Error("Erro ao atualizar categoria");
    }
  },
  async deletar(id) {
    try {
      await api.delete(`/produtos/categorias/${id}`);
    } catch (error) {
