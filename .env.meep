# MEEP Service Configuration
# Sistema completo de configuração MEEP

# ===============================================
# DATABASE
# ===============================================
DATABASE_URL=postgresql://user:password@localhost:5432/paineluniversal
# Para SQLite local:
# DATABASE_URL=sqlite:///./paineluniversal.db

# ===============================================
# REDIS CACHE
# ===============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_TTL_DEFAULT=86400  # 24 horas em segundos
REDIS_TTL_CPF=86400      # Cache de validação CPF
REDIS_TTL_ANALYTICS=3600 # Cache de analytics (1 hora)

# ===============================================
# MEEP SERVICE
# ===============================================
MEEP_SERVICE_PORT=3001
MEEP_SERVICE_HOST=0.0.0.0
NODE_ENV=development

# ===============================================
# CPF VALIDATION
# ===============================================
# Salt para hash de CPF (LGPD compliance)
CPF_SALT=meep_secure_salt_2024_change_this_in_production

# API Receita Federal (opcional - fallback para validação matemática)
API_RECEITA_FEDERAL_URL=https://api.receitafederal.gov.br/v1
API_RECEITA_TOKEN=seu_token_aqui_se_tiver

# Rate limiting para validação CPF
CPF_RATE_LIMIT_WINDOW_MS=60000  # 1 minuto
CPF_RATE_LIMIT_MAX_REQUESTS=10

# ===============================================
# SECURITY
# ===============================================
JWT_SECRET=meep_jwt_secret_super_secure_change_in_production
JWT_EXPIRATION=7d
BCRYPT_ROUNDS=10

# CORS Origins (separados por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ===============================================
# WHATSAPP BUSINESS (Opcional)
# ===============================================
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_URL=

# N8N Integration (Opcional)
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/meep
N8N_API_KEY=

# ===============================================
# AI/ANALYTICS
# ===============================================
# Configurações para previsões de IA
AI_CONFIDENCE_THRESHOLD=70  # Mínimo de confiança para exibir previsões
AI_PREDICTION_HOURS=12      # Horas à frente para prever
AI_HISTORICAL_DAYS=7        # Dias de histórico para análise

# Fatores de ajuste para previsões
AI_FACTOR_WEEKEND=1.3       # Aumento de 30% nos fins de semana
AI_FACTOR_PRIME_TIME=1.5    # Aumento de 50% no horário nobre (19h-23h)
AI_FACTOR_BUSINESS_HOURS=0.8 # Redução de 20% em horário comercial

# ===============================================
# MONITORING
# ===============================================
# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/meep-service.log
LOG_MAX_FILES=14d  # Manter logs por 14 dias

# Health Check
HEALTH_CHECK_INTERVAL=30000  # 30 segundos
EQUIPMENT_OFFLINE_THRESHOLD=120000  # 2 minutos sem resposta = offline

# ===============================================
# RATE LIMITING
# ===============================================
# Global rate limit
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos
RATE_LIMIT_MAX_REQUESTS=1000

# Endpoint-specific limits
API_CPF_LIMIT_WINDOW_MS=60000
API_CPF_LIMIT_MAX=10
API_CHECKIN_LIMIT_WINDOW_MS=60000
API_CHECKIN_LIMIT_MAX=30
API_ANALYTICS_LIMIT_WINDOW_MS=60000
API_ANALYTICS_LIMIT_MAX=100

# ===============================================
# PERFORMANCE
# ===============================================
# Connection pooling
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Request limits
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000

# ===============================================
# FEATURES FLAGS
# ===============================================
FEATURE_CPF_VALIDATION=true
FEATURE_MULTI_FACTOR_CHECKIN=true
FEATURE_AI_PREDICTIONS=true
FEATURE_WHATSAPP_INTEGRATION=false
FEATURE_EQUIPMENT_MONITORING=true
FEATURE_REAL_TIME_ANALYTICS=true

# ===============================================
# DEVELOPMENT
# ===============================================
DEBUG=false
MOCK_CPF_API=true  # Usar validação matemática ao invés de API real
MOCK_WHATSAPP=true # Simular envios WhatsApp
SEED_DATABASE=true  # Popular banco com dados de teste

# ===============================================
# PRODUCTION (Railway/Heroku/etc)
# ===============================================
# Estas variáveis são automaticamente definidas em produção
# PORT=
# RAILWAY_ENVIRONMENT=
# DATABASE_URL=
# REDIS_URL=