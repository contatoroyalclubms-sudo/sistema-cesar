# MEEP Integration Configuration
# Kit de Integração Legal - Sem código proprietário

# Base Configuration
MEEP_BASE_URL=http://localhost:8002
MEEP_AUTH_MODE=cookie
MEEP_BEARER_TOKEN=           # Token se usar bearer
MEEP_USER=teste@empresa.com  # Usuario de teste
MEEP_PASS=senha123           # Senha de teste
MEEP_TIMEOUT=30

# API Endpoints (mapeados da captura)
MEEP_LOGIN_ENDPOINT=/api/auth/login
MEEP_EVENTS_ENDPOINT=/api/events
MEEP_TICKETS_ENDPOINT=/api/tickets
MEEP_CHECKIN_ENDPOINT=/api/checkin
MEEP_ANALYTICS_ENDPOINT=/api/analytics

# Sync Configuration
MEEP_SYNC_INTERVAL=3600     # segundos
MEEP_BATCH_SIZE=100
MEEP_RETRY_ATTEMPTS=3
MEEP_ENABLE_CACHE=true