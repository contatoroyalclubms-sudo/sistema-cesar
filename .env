# Configuração LOCAL para testes com SQLite
# Database local com SQLite
DATABASE_URL=sqlite:///./eventos.db
DATABASE_TYPE=sqlite
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false
ENABLE_MIGRATIONS=true

# Security
SECRET_KEY=test_secret_key_local_development_only
JWT_SECRET=test_jwt_secret_local_development_only
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
DEBUG=true
SECURE_COOKIES=false
SECURE_HEADERS=false

# External APIs (mock/local)
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test_password
WHATSAPP_TOKEN=test_token
N8N_WEBHOOK_URL=http://localhost:5678/webhook
API_RECEITA_FEDERAL_URL=https://api.receitafederal.gov.br/v1

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_MEEP_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:8000

# Features
ENABLE_ANALYTICS=true
PWA_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true

# Other configurations
ANALYTICS_RETENTION_DAYS=90
API_RECEITA_TOKEN=test_token
CPF_SALT=test_salt_for_hashing
EQUIPMENT_DISCOVERY_ENABLED=true
EQUIPMENT_HEARTBEAT_INTERVAL=30
OFFLINE_SYNC_ENABLED=true
REDIS_URL=redis://localhost:6379