# Configurações do MCP Browser Automation

# Modo de execução
NODE_ENV=development

# Configurações do navegador padrão
DEFAULT_BROWSER=chromium
DEFAULT_HEADLESS=false

# Timeouts padrão (em ms)
DEFAULT_TIMEOUT=30000
DEFAULT_NAVIGATION_TIMEOUT=60000

# Diretório para screenshots
SCREENSHOT_DIR=./screenshots

# Diretório para downloads
DOWNLOAD_DIR=./downloads

# Credenciais (NUNCA commitar com valores reais!)
GITHUB_USERNAME=
GITHUB_PASSWORD=
GOOGLE_USERNAME=
GOOGLE_PASSWORD=
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=